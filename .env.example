# Copy to .env and adjust. Every value here is also a plain environment
# variable (prefix RAG_) - see src/ragengine/config.py for the full list
# and defaults. Nothing here is required: the service runs with zero
# configuration using fake embeddings + a stub LLM + in-memory Chroma.

# --- Splitting ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_SPLITTER=recursive_character

# --- Embeddings ---
# fake | sentence_transformers
RAG_EMBEDDING_BACKEND=fake
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
RAG_EMBEDDING_DIMENSIONS=768

# --- Vector store ---
# chroma | faiss
RAG_VECTOR_STORE_BACKEND=chroma
# Leave unset for in-memory; set to persist Chroma to disk between restarts
RAG_VECTOR_STORE_PERSIST_DIR=
# Give each independent deployment/tenant its own name - see config.py's
# note on why two pipelines sharing a name would share data in-process.
RAG_COLLECTION_NAME=ragengine

# --- LLM (generation + agent reasoning) ---
# stub | ollama | huggingface
RAG_LLM_BACKEND=stub
RAG_LLM_MODEL_NAME=llama3.2
RAG_OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval ---
# similarity | mmr | similarity_score_threshold | multi_query | parent_document | self_query
RAG_DEFAULT_RETRIEVER=similarity
RAG_TOP_K=4

# --- Agent ---
RAG_AGENT_MAX_ITERATIONS=3
